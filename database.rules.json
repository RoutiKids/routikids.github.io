{
  "rules": {
    "houses": {
      "$houseId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        "data": {
          ".write": "auth != null && root.child('houses').child($houseId).child('members').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['config', 'updatedAt', 'rev'])",
          "config": { ".validate": "newData.isString() && newData.val().length <= 100000" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "rev": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "$other": { ".validate": false }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (root.child('houses').child($houseId).child('members').child(auth.uid).exists() || ($uid === auth.uid && newData.exists() && (!root.child('houses').child($houseId).exists() || (root.child('pairCodes').child(newData.child('code').val() + '').child('houseId').val() === $houseId && root.child('pairCodes').child(newData.child('code').val() + '').child('expiresAt').val() > now))))",
            ".validate": "newData.hasChildren(['name', 'kind', 'joinedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "kind": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "code": { ".validate": "newData.isString() && newData.val().length == 6" },
            "$other": { ".validate": false }
          }
        },
        "progress": {
          ".write": "auth != null && root.child('houses').child($houseId).child('members').child(auth.uid).exists()",
          "$childId": {
            ".validate": "$childId.length <= 32 && newData.hasChildren(['state', 'seq', 'updatedAt'])",
            "state": { ".validate": "newData.isString() && newData.val().length <= 100000" },
            "seq": { ".validate": "newData.isNumber()" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "pairCodes": {
      "$code": {
        ".read": "auth != null && $code.length == 6",
        ".write": "auth != null && $code.length == 6 && ((newData.exists() && root.child('houses').child(newData.child('houseId').val() + '').child('members').child(auth.uid).exists() && (!data.exists() || data.child('expiresAt').val() < now || data.child('houseId').val() === newData.child('houseId').val())) || (!newData.exists() && root.child('houses').child(data.child('houseId').val() + '').child('members').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['houseId', 'expiresAt'])",
        "houseId": { ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 64" },
        "expiresAt": { ".validate": "newData.isNumber() && newData.val() <= now + 3600000" },
        "$other": { ".validate": false }
      }
    }
  }
}
